{
  "color": {
    "$type": "color",
    "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1 } },
    "gray": { "900": { "$value": "#1f2937" } },
    "surface": { "card": { "$value": "{color.white}" } },
    "text": { "primary": { "$value": "{color.gray.900}" } },
    "shadow": { "card": { "$value": "#0f172a14" } }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": { "value": 8, "unit": "px" } }
  },
  "spacing": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Pretendard Variable", "Pretendard", "sans-serif"] }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "{color.shadow.card}",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 2, "unit": "px" },
        "blur": { "value": 8, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  },
  "gradient": {
    "header": {
      "$type": "gradient",
      "$value": [
        { "color": "#f8fafc", "position": 0 },
        { "color": "#eef2f7", "position": 1 }
      ]
    }
  }
}
